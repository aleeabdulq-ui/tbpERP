# ── Environment ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Origin of the web app (used for CORS)
WEB_ORIGIN=http://localhost:5173

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=mysql://erp:erp_password@localhost:3306/nexus_erp

# ── Auth secrets (REQUIRED — at least 32 random chars each) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-random-32-char-minimum-string
JWT_REFRESH_SECRET=change-me-to-a-different-random-32-char-string

# Optional: dedicated key for AES-256-GCM encryption of NIN/BVN/account numbers.
# Falls back to JWT_REFRESH_SECRET if unset — set a dedicated key in production.
# DATA_ENCRYPTION_KEY=

# ── Session tuning ───────────────────────────────────────────
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# Set true behind HTTPS in production
COOKIE_SECURE=false
